# Application Environment
NODE_ENV=development

# PostgreSQL Connection String (Supabase / Render / Neon / Local)
# Example Supabase pooled connection: postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rss_bot

# Discord Bot Credentials (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id_here

# Optional: Discord Guild ID for instant slash command registration in development
# When omitted, commands are registered globally (which may take a few minutes on Discord's side)
DISCORD_GUILD_ID=

# HTTP Web Server Settings (Render assigns PORT dynamically)
PORT=3000
HOST=0.0.0.0

# Polling Configuration
POLL_INTERVAL_DEFAULT_SECONDS=600
POLL_INTERVAL_MIN_SECONDS=60
CONCURRENT_POLL_LIMIT=5
FETCH_TIMEOUT_MS=10000
MAX_FEED_SIZE_MB=15
USER_AGENT=RSS-Discord-Bot/1.0 (+https://github.com/your-username/rss-bot)

